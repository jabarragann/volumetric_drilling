    url: https://github.com/jhu-cisst/cisst-ros.git
    version: 7aeca1adf4e7a1ab1f6aeb2218896a1d4a4eb197
  # TODO: THE LOCAL COPY OF SAWATRACSYSFUSIONTRACK HAS UNCOMMITTED CMAKE CHANGES
  # (cisst_FOUND_AS_REQUIRED -> cisst_FOUND, cisst_target_link_libraries ->
  # target_link_libraries) THAT THIS PIN DOES NOT INCLUDE. A FRESH IMPORT MAY NOT
  # BUILD. PUSH THOSE CHANGES TO A FORK/BRANCH AND UPDATE THIS ENTRY.
  atracsys/cisst-saw/sawAtracsysFusionTrack:
    type: git
    url: https://github.com/jhu-saw/sawAtracsysFusionTrack.git
    version: d5c508a969f304cd944482cab85401ce4c0e2be9
  atracsys/crtk/crtk_msgs:
