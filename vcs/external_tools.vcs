repositories:
  # Pinned to specific commits: these repositories change often.
  # Update a pin only after testing the new version.

  ## Data recording
  dvrk_data:
    type: git
    url: git@github.com:jhu-dvrk/dvrk_data.git
    version: 3f1254d944301922598aa6acce2c16294bc57a97

  ## Atracsys tracker
  atracsys/cisst-saw/cisst:
